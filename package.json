{
  "name": "chillpass",
  "version": "1.0.0-dev",
  "description": "ChillPass - 期末冲刺助手 | AI 驱动的闯关式备考应用",
  "main": "dist-electron/main.js",
  "author": "ChillPass",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win",
    "electron:preview": "vite build && electron ."
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "jszip": "^3.10.1",
    "lucide-react": "^0.427.0",
    "marked": "^14.0.0",
    "nanoid": "^5.0.7",
    "pdfjs-dist": "^4.4.168",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.chillpass.app",
    "productName": "ChillPass",
    "copyright": "Copyright © 2026 ChillPass",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "uninstallDisplayName": "ChillPass 期末冲刺助手",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ChillPass",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "language": "2052",
      "differentialPackage": true
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png"
    }
  }
}
